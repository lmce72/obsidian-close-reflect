{
  "name": "obsidian-close-reflect",
  "version": "1.3.1",
  "private": true,
  "description": "Intercept Obsidian's quit and show a reflection modal before the window closes.",
  "author": "CoreVortex",
  "license": "MIT",
  "scripts": {
    "build": "bun build src/main.ts --outfile=main.js --target=node --format=cjs --external obsidian --external @codemirror/state --external @codemirror/view",
    "dev": "bun build src/main.ts --outfile=main.js --target=node --format=cjs --external obsidian --external @codemirror/state --external @codemirror/view --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "obsidian": "1.13.1",
    "typescript": "7.0.2"
  }
}
